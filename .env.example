# Runtime environment. Allowed values: dev, prod, test.
ENV=prod

# Application log level, for example: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Absolute path to the local codex binary used to start the app-server.
CODEX_BIN=/opt/homebrew/bin/codex

# Root directory for all local application data.
# The effective workspace path is derived as APP_ROOT_PATH/workspace.
# The effective SQLite path is derived as APP_ROOT_PATH/data/codex_im_connector.db.
APP_ROOT_PATH=~/.cic

# Additional allowed cwd roots as a JSON array of absolute or home-relative paths.
# Example: ["~/work/project-a", "/Users/name/repos"]
# APP_ROOT_PATH/workspace is always treated as an allowed root automatically.
# Effective allowed roots = CODEX_ALLOWED_CWD_ROOTS + APP_ROOT_PATH/workspace.
CODEX_ALLOWED_CWD_ROOTS=[]

# Default model to use when a user has not selected a model yet.
# Leave empty only if you want the runtime to fall back to server/model defaults.
CODEX_MODEL=gpt-5.4-mini

# Default reasoning effort for new turns when the user has not selected one yet.
# Allowed values: none, minimal, low, medium, high, xhigh.
CODEX_DEFAULT_REASONING_EFFORT=high

# Codex approval policy for tool calls and other guarded actions.
# Allowed values: untrusted, on-failure, on-request, never.
CODEX_APPROVAL_POLICY=on-request

# Maximum number of retry attempts for transient Codex overload errors.
# Must be an integer >= 1.
CODEX_RETRY_MAX_ATTEMPTS=3

# Initial retry delay in seconds for transient Codex overload errors.
# Must be a positive float.
CODEX_RETRY_INITIAL_DELAY_S=0.5

# Maximum retry delay in seconds for transient Codex overload errors.
# Must be a positive float and should be >= CODEX_RETRY_INITIAL_DELAY_S.
CODEX_RETRY_MAX_DELAY_S=5.0

# Maximum time in seconds to wait for a compact operation to finish.
# Must be a positive float.
CODEX_COMPACT_TIMEOUT_S=300.0

# Minimum interval in seconds between streamed message patch updates to IM.
# Must be a positive float.
STREAM_PATCH_INTERVAL_S=2.0

# Feishu application ID for the bot app.
FEISHU_APP_ID=

# Feishu application secret for the bot app.
FEISHU_APP_SECRET=

# Emoji used for the immediate ACK reaction on inbound messages.
# Must be a valid Feishu emoji type string.
# Reference: https://open.feishu.cn/document/server-docs/im-v1/message-reaction/emojis-introduce
FEISHU_REACTION_EMOJI=OK
